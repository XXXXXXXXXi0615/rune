{
  "name": "lunartide-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "assets:sync:clawd": "node scripts/sync-clawd-pets.mjs",
    "assets:check:clawd": "node scripts/sync-clawd-pets.mjs --check",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "mcp:test-server": "node scripts/mcp-test-server.mjs",
    "pet:companion": "node scripts/pet-agent-companion.mjs",
    "tidewatch:relay": "node scripts/tidewatch-codex-relay.mjs",
    "pet:hook": "node scripts/codex-pet-hook.mjs",
    "pet:hook:detect": "node scripts/pet-hook-installer.mjs detect",
    "pet:hook:install": "node scripts/pet-hook-installer.mjs install",
    "pet:hook:repair": "node scripts/pet-hook-installer.mjs repair",
    "pet:hook:uninstall": "node scripts/pet-hook-installer.mjs uninstall",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:pages": "node scripts/preview-pages.mjs",
    "test:tidecount-editor": "npx playwright test e2e/countdown-custom-picker.spec.ts e2e/countdown-picker.spec.ts --project=chrome-local",
    "test:companion-presentation": "npx playwright test e2e/companion-display-simplify.spec.ts --project=chromium --project=webkit",
    "test:group-settings-shell": "npx playwright test e2e/group-settings-compact-shell.spec.ts --project=chromium --project=webkit",
    "test:companion-recovery": "npx playwright test e2e/companion-interaction-recovery.spec.ts --project=chromium --project=webkit",
    "test:chat-dark-parity": "npx playwright test e2e/chat-dark-runtime-parity-closure.spec.ts --project=chromium --project=webkit",
    "test:chat-dark-surface": "npx playwright test e2e/chat-dark-surface-closure.spec.ts --project=chromium --project=webkit",
    "test:group-header-tray": "npx playwright test e2e/group-chat-header-tray-phase1.spec.ts --project=chromium --project=webkit",
    "test:group-ux-phase1": "npx playwright test e2e/group-chat-ux-consolidation-phase1.spec.ts --project=chromium --project=webkit",
    "test:chat-presentation": "npx playwright test e2e/rune-chat-theme-phase1.spec.ts e2e/chat-background-phase1.spec.ts e2e/chat-paired-header.spec.ts e2e/rune-stash-phase1.1-compact.spec.ts --project=chromium --project=webkit --workers=2",
    "test:chat:baseline": "npx playwright test e2e/chat-final-route-baseline.spec.ts e2e/chat-paired-header.spec.ts e2e/chat-conversation-avatars.spec.ts e2e/chat-composer-cleanup.spec.ts e2e/chat-composer-attachment-final.spec.ts e2e/chat-bubble-skin-phase1a.spec.ts e2e/chat-bubble-skin-phase1b-importer.spec.ts e2e/chat-bubble-skin-phase1c-roundtrip.spec.ts e2e/chat-bubble-skin-phase1d-studio.spec.ts e2e/rune-chat-theme-phase1.spec.ts e2e/chat-background-phase1.spec.ts e2e/chat-call-phase2b.spec.ts e2e/chat-call-global-runtime.spec.ts e2e/group-relationship-phase2b.spec.ts --project=chromium --project=webkit --workers=2",
    "test:rune-stash-2a": "npx playwright test e2e/rune-stash-phase2a-color-lab.spec.ts e2e/rune-stash-phase1.1-compact.spec.ts --project=chromium --project=webkit --workers=2",
    "test:rune-stash-2b": "npx playwright test e2e/rune-stash-phase2b-chat-theme-bridge.spec.ts --project=chromium --project=webkit --workers=2"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@supabase/supabase-js": "^2.108.2",
    "astronomy-engine": "^2.1.19",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "classnames": "^2.5.1",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "thinking-orbs": "0.1.1",
    "three": "^0.185.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
